# Project metadata
PROJECT_NAME="CashFlow AI"
PROJECT_VERSION="1.0.0"

# Security Configurations
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY="YOUR_SUPER_SECRET_KEY_JWT_SIGNING_TOKEN_HERE"

# Database Configuration
# Fallback is sqlite:///./cashflow.db if not specified
DATABASE_URL="postgresql://postgres:password@localhost:5432/cashflow_ai"

# Google Gemini API Configurations
# Request keys from Google AI Studio. Offline fallback will execute if left empty.
GEMINI_API_KEY="AIzaSyYourGeminiAPIKeyHere"
GEMINI_MODEL="gemini-1.5-flash"
